# Server Port
PORT=5050

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/campuspulse?retryWrites=true&w=majority

# JWT Signing Secret (Generate a strong 64-char random string)
JWT_SECRET=your_super_secret_jwt_key_campuspulse_2026

# Deployed Frontend Client URL (Used for production CORS)
CLIENT_URL=http://localhost:5173
